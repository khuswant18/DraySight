# Solari cloud browser API key — get one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Portal mode:
#   "demo" — built-in PacificPort Demo Terminal (default, requires NEXT_PUBLIC_BASE_URL)
#   "lbct" — LBCT, Long Beach Container Terminal (real-world, public, no login required)
PORTAL_MODE=demo

# Maximum concurrent Solari browser sessions
MAX_CONCURRENCY=3

# Public base URL for the demo terminal (Solari cloud browsers navigate here)
# In development: use ngrok or similar to expose localhost
# In production: your deployment URL (e.g. https://draysight.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
